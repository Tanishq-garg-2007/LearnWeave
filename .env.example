# LearnWeave AI Environment Configuration

# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_PRIMARY_MODEL=qwen/qwen3.8-27b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_REASONING_MODE=hidden
GROQ_TIMEOUT_SECONDS=60
GROQ_MAX_RETRIES=3
GROQ_MAX_COMBINED_TOKENS=6000

# Database Configuration (PostgreSQL + pgvector)
# Required for docker-compose. Choose a strong value; the compose file will not start without it.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=learnweave
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/learnweave
SYNC_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/learnweave

# Security & Authentication
# REQUIRED outside APP_ENV=development: at least 32 random characters.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Leave empty only for local development (a random per-process secret is used then).
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Local Embeddings & TTS
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
KOKORO_MODEL_PATH=models/kokoro-v1.0.onnx
KOKORO_VOICES_PATH=models/voices.bin

# Optional Integrations
ENABLE_MEM0=false

# App Settings
# Set to "production" (or anything other than "development") on deployed servers:
# this enables startup checks for JWT_SECRET and default DB credentials, and disables /docs.
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
